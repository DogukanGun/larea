  "info": {
    "title": "Larea API",
    "description": "Location-based chat backend. Realtime events are documented in docs/realtime-protocol.md.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "example": "anna_k",
            "description": "Display name must be 3-24 characters: letters, numbers, spaces, underscores or dots."
          },
          "deviceLabel": {
            "type": "string",
            "example": "iPhone 15"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string"
          },
          "deviceLabel": {
            "type": "string",
            "example": "Pixel 8"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Display name must be 3-24 characters: letters, numbers, spaces, underscores or dots."
          }
        },
        "required": [
          "displayName"
        ]
      },
      "PlatformAgeDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "apple",
              "google"
            ]
          },
          "lowerBound": {
            "type": "number",
            "description": "Lower bound of the shared age range; absent when the user declined"
          },
          "upperBound": {
            "type": "number"
          },
          "declaration": {
            "type": "string",
            "enum": [
              "self",
              "guardian",
              "confirmed",
              "unknown"
            ],
            "description": "How the platform obtained the age range"
          }
        },
        "required": [
          "platform",
          "declaration"
        ]
      },
      "LocationFixDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 52.5219
          },
          "lng": {
            "type": "number",
            "example": 13.4132
          },
          "accuracy": {
            "type": "number",
            "description": "Horizontal accuracy radius in metres (68% confidence)",
            "example": 12
          },
          "mocked": {
            "type": "boolean",
            "description": "True when the OS reports a mock/simulated location"
          }
        },
        "required": [
          "lat",
          "lng",
          "accuracy"
        ]
      },
      "CreateListingDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 52.5219
          },
          "lng": {
            "type": "number",
            "example": 13.4132
          },
          "accuracy": {
            "type": "number",
            "description": "Horizontal accuracy radius in metres (68% confidence)",
            "example": 12
          },
          "mocked": {
            "type": "boolean",
            "description": "True when the OS reports a mock/simulated location"
          },
          "kind": {
            "type": "string",
            "enum": [
              "OFFER",
              "REQUEST"
            ],
            "description": "OFFER = selling something, REQUEST = asking for paid help"
          },
          "category": {
            "type": "string",
            "enum": [
              "FURNITURE",
              "ELECTRONICS",
              "CLOTHING",
              "KIDS",
              "HOME",
              "SPORTS",
              "BOOKS",
              "SERVICES",
              "HELP",
              "OTHER"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "example": "IKEA desk, good condition"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "priceCents": {
            "type": "number",
            "description": "Asking price (OFFER) or budget (REQUEST) in cents",
            "example": 2500
          },
          "mediaIds": {
            "description": "Upload ids from POST /uploads, in display order",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "lat",
          "lng",
          "accuracy",
          "kind",
          "category",
          "title",
          "priceCents"
        ]
      },
      "UpdateListingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "category": {
            "type": "string",
            "enum": [
              "FURNITURE",
              "ELECTRONICS",
              "CLOTHING",
              "KIDS",
              "HOME",
              "SPORTS",
              "BOOKS",
              "SERVICES",
              "HELP",
              "OTHER"
            ]
          },
          "priceCents": {
            "type": "number"
          },
          "mediaIds": {
            "description": "Replaces the photo list; ids already on the listing are kept, new upload ids are attached",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateOfferDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 52.5219
          },
          "lng": {
            "type": "number",
            "example": 13.4132
          },
          "accuracy": {
            "type": "number",
            "description": "Horizontal accuracy radius in metres (68% confidence)",
            "example": 12
          },
          "mocked": {
            "type": "boolean",
            "description": "True when the OS reports a mock/simulated location"
          },
          "amountCents": {
            "type": "number",
            "description": "Proposed price in cents",
            "example": 2000
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "lat",
          "lng",
          "accuracy",
          "amountCents"
        ]
      },
      "SendMessageDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "TEXT",
              "IMAGE"
            ],
            "default": "TEXT",
            "description": "IMAGE messages carry a mediaId from POST /uploads and an optional caption in text"
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "example": "Anyone want to get food?",
            "description": "Required for TEXT; optional caption for IMAGE"
          },
          "mediaId": {
            "type": "string",
            "description": "Upload id for IMAGE messages"
          },
          "clientKey": {
            "type": "string",
            "description": "Client-generated idempotency key (e.g. a UUID); resending with the same key returns the original result"
          }
        },
        "required": [
          "clientKey"
        ]
      },
      "CreatePollDto": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 200,
            "example": "Pizza or ramen tonight?"
          },
          "options": {
            "minItems": 2,
            "maxItems": 6,
            "example": [
              "Pizza",
              "Ramen"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "durationMinutes": {
            "type": "number",
            "description": "Minutes until the poll closes on its own (5 minutes to 7 days); open until closed when omitted"
          },
          "clientKey": {
            "type": "string",
            "description": "Client-generated idempotency key"
          }
        },
        "required": [
          "question",
          "options",
          "clientKey"
        ]
      },
      "VoteDto": {
        "type": "object",
        "properties": {
          "optionId": {
            "type": "string"
          }
        },
        "required": [
          "optionId"
        ]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "THREAT",
              "HATE",
              "SEXUAL",
              "SPAM",
              "SCAM",
              "PERSONAL_INFO",
              "OTHER",
              "PROHIBITED_ITEM",
              "OFF_PLATFORM_PAYMENT"
            ]
          },
          "details": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "ResolveReportDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "DISMISS",
              "HIDE_CONTENT",
              "HIDE_MESSAGE",
              "MUTE",
              "SUSPEND"
            ]
          },
          "durationHours": {
            "type": "number",
            "description": "Mute length in hours (MUTE only)",
            "default": 24
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "action"
        ]
      },
      "SuspendUserDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
