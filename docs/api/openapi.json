    "/venues/nearby": {
      "get": {
        "operationId": "VenuesController_nearby",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "schema": {
              "example": 52.5219,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "schema": {
              "example": 13.4132,
              "type": "number"
            }
          },
          {
            "name": "accuracy",
            "required": true,
            "in": "query",
            "description": "Horizontal accuracy radius in metres (68% confidence)",
            "schema": {
              "example": 12,
              "type": "number"
            }
          },
          {
            "name": "mocked",
            "required": false,
            "in": "query",
            "description": "True when the OS reports a mock/simulated location",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "viewLat",
            "required": false,
            "in": "query",
            "description": "Latitude of the map viewport centre; defaults to the fix",
            "schema": {
              "example": 48.1374,
              "type": "number"
            }
          },
          {
            "name": "viewLng",
            "required": false,
            "in": "query",
            "description": "Longitude of the map viewport centre; defaults to the fix",
            "schema": {
              "example": 11.5755,
              "type": "number"
            }
          },
          {
            "name": "viewRadiusM",
            "required": false,
            "in": "query",
            "description": "Half the visible map width in metres; capped at DISCOVERY_MAX_RADIUS_M. Cafés are only included up to DISCOVERY_RADIUS_M.",
            "schema": {
              "example": 1500,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Real places where the map is looking (discovered from OpenStreetMap), nearest to the phone first",
        "tags": [
          "venues"
        ]
      }
    },
