        "tags": [
          "market"
        ]
      },
      "get": {
        "operationId": "ListingsController_feed",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "schema": {
              "example": 52.5219,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "schema": {
              "example": 13.4132,
              "type": "number"
            }
          },
          {
            "name": "accuracy",
            "required": true,
            "in": "query",
            "description": "Horizontal accuracy radius in metres (68% confidence)",
            "schema": {
              "example": 12,
              "type": "number"
            }
          },
          {
            "name": "mocked",
            "required": false,
            "in": "query",
            "description": "True when the OS reports a mock/simulated location",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "radiusM",
            "required": false,
            "in": "query",
            "description": "Search radius in metres, capped at MARKET_RADIUS_M",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "kind",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "OFFER",
                "REQUEST"
              ]
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "FURNITURE",
                "ELECTRONICS",
                "CLOTHING",
                "KIDS",
                "HOME",
                "SPORTS",
                "BOOKS",
                "SERVICES",
                "HELP",
                "OTHER"
              ]
            }
          },
          {
            "name": "minPriceCents",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxPriceCents",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Words to look for in the title",
            "schema": {
              "maxLength": 60,
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "distance",
              "type": "string",
              "enum": [
                "distance",
                "newest",
                "price"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listings within reach of the given fix, with filters",
        "tags": [
          "market"
        ]
      }
    },
