  "info": {
    "title": "Larea API",
    "description": "Location-based chat backend. Realtime events are documented in docs/realtime-protocol.md.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "example": "anna_k",
            "description": "Display name must be 3-24 characters: letters, numbers, spaces, underscores or dots."
          },
          "deviceLabel": {
            "type": "string",
            "example": "iPhone 15"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string"
          },
          "deviceLabel": {
            "type": "string",
            "example": "Pixel 8"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Display name must be 3-24 characters: letters, numbers, spaces, underscores or dots."
          }
        },
        "required": [
          "displayName"
        ]
      },
      "PlatformAgeDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "apple",
              "google"
            ]
          },
          "lowerBound": {
            "type": "number",
            "description": "Lower bound of the shared age range; absent when the user declined"
          },
          "upperBound": {
            "type": "number"
          },
          "declaration": {
            "type": "string",
            "enum": [
              "self",
              "guardian",
              "confirmed",
              "unknown"
            ],
            "description": "How the platform obtained the age range"
          }
        },
        "required": [
          "platform",
          "declaration"
        ]
      },
      "LocationFixDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 52.5219
          },
          "lng": {
            "type": "number",
            "example": 13.4132
          },
          "accuracy": {
            "type": "number",
            "description": "Horizontal accuracy radius in metres (68% confidence)",
            "example": 12
          },
          "mocked": {
            "type": "boolean",
            "description": "True when the OS reports a mock/simulated location"
          }
        },
        "required": [
          "lat",
          "lng",
          "accuracy"
        ]
      },
      "SendMessageDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "example": "Anyone want to get food?"
          },
          "clientKey": {
            "type": "string",
            "description": "Client-generated idempotency key (e.g. a UUID); resending with the same key returns the original result"
          }
        },
        "required": [
          "text",
          "clientKey"
        ]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "THREAT",
              "HATE",
              "SEXUAL",
              "SPAM",
              "SCAM",
              "PERSONAL_INFO",
              "OTHER"
            ]
          },
          "details": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "ResolveReportDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "DISMISS",
              "HIDE_MESSAGE",
              "MUTE",
              "SUSPEND"
            ]
          },
          "durationHours": {
            "type": "number",
            "description": "Mute length in hours (MUTE only)",
            "default": 24
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "action"
        ]
      },
      "SuspendUserDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
