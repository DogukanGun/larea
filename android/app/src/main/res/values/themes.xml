<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Larea" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Branded launch: violet background with the white glyph (iOS LaunchBackground + LaunchLogo). -->
    <style name="Theme.Larea.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Larea</item>
    </style>
</resources>
