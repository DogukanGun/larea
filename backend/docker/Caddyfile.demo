# Production site plus the demo API under DEMO_DOMAIN (see docker-compose.demo.yml).
import /etc/caddy/Caddyfile

{$DEMO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex"
		-Server
	}

	handle_path /media/* {
		root * /srv/media-demo/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			hide *.tmp
		}
	}

	@uploads path /uploads
	handle @uploads {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend-demo:3000
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend-demo:3000
	}
}
