# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Infrastructure
DATABASE_URL=postgresql://larea:larea@localhost:5433/larea
REDIS_URL=redis://localhost:6380

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Moderation (OpenAI): free moderation endpoint as a hard floor + a small model for the verdict
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=8000

# Presence and eligibility
JOIN_RADIUS_M=200
LEAVE_RADIUS_M=250
MAX_ACCURACY_M=100
HEARTBEAT_INTERVAL_SEC=25
STALE_AFTER_SEC=120
WEAK_GPS_GRACE_SEC=300
OUT_OF_RANGE_STRIKES=2
MAX_SPEED_MPS=50
# Accept simulator/emulator fixes (local development only; refused in production)
ALLOW_MOCK_LOCATIONS=0
DISCOVERY_RADIUS_M=1500
DISCOVERY_MAX_RADIUS_M=12000
NEARBY_MAX_VENUES=150

# Real places come from OpenStreetMap (Overpass API), discovered per area and cached
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
OVERPASS_CONTACT=dogukangundogan5@gmail.com
OSM_CACHE_TTL_SEC=86400

# Distinct reporters within 24 h that hide a message pending review
REPORT_AUTO_HIDE_THRESHOLD=3

# Retention
MESSAGE_RETENTION_DAYS=7
MODERATION_RECORD_RETENTION_DAYS=90

LOG_PRETTY=0

# Uploaded images (chat photos, listings). Files live on a volume; Caddy serves them in production.
MEDIA_DIR=./var/uploads
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PX=1600
MEDIA_THUMB_PX=400
MEDIA_ORPHAN_TTL_MIN=60
MEDIA_DISK_RESERVE_BYTES=1073741824

# Neighbourhood marketplace (listings within MARKET_RADIUS_M; Stripe payments are a separate switch).
MARKET_ENABLED=1
MARKET_PAYMENTS_ENABLED=0
MARKET_RADIUS_M=2000
MARKET_CURRENCY=eur
MARKET_FEE_PERCENT=10
MARKET_FEE_MIN_CENTS=50
MARKET_LISTING_TTL_DAYS=30
MARKET_LISTING_PURGE_DAYS=30
MARKET_OFFER_TTL_HOURS=72
MARKET_MIN_PRICE_CENTS=100
MARKET_MAX_PRICE_CENTS=50000
MARKET_MAX_DAILY_VOLUME_CENTS=100000
MARKET_MAX_IMAGES=5
MARKET_MIN_ACCOUNT_AGE_HOURS=24
MARKET_APPROVAL_DAYS=14
MARKET_PAYMENT_WINDOW_HOURS=24

# Stripe (Connect Express payouts, hosted Checkout). Leave empty to keep payments off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ACCOUNT_COUNTRY=DE
STRIPE_ALLOW_TEST_MODE=0

# Paid message pins on the map. Prices and product ids are fixed in src/pins/pricing.ts; create the same
# four consumables in App Store Connect and Play Console. App Store Server Notifications v2 URL:
# ${PUBLIC_URL}/pins/apple/notifications
PINS_ENABLED=1
PIN_NEARBY_RADIUS_M=1000
PIN_CHAT_RADIUS_M=300
NOMINATIM_URL=https://nominatim.openstreetmap.org
APPLE_BUNDLE_ID=com.dogukangundogan.larea
# Numeric Apple ID of the app (App Store Connect → App Information); needed to verify production purchases.
APPLE_APP_ID=
# Development only: accept purchases from Xcode's local StoreKit configuration.
APPLE_IAP_ALLOW_XCODE=0
GOOGLE_PLAY_PACKAGE=com.dogukangundogan.larea
# Service account JSON key with Play Console access ("View financial data" + "Manage orders").
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# Solana dApp Store build (docs/solana.md). Off by default; `pnpm solana:setup --cluster devnet`
# fills in the keys, collections, tree and test mints. Secret keys never go into git.
SOLANA_ENABLED=0
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DAS_URL=
SOLANA_AUTHORITY_SECRET=
SOLANA_ESCROW_SECRET=
SOLANA_REWARDS_SECRET=
SOLANA_STAMP_TREE=
SOLANA_STAMP_COLLECTION=
SOLANA_LEVEL_COLLECTION=
USDC_MINT=
SKR_MINT=
LOYALTY_LEVELS=5,15,40
SKR_LEVEL_REWARD=5
