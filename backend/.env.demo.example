# Demo API for testers and judges (docker-compose.demo.yml). Development mode: simulated locations
# are accepted, the age step can be self-declared, and new accounts may trade right away.
NODE_ENV=development
PUBLIC_URL=https://demo.example.com

# A different secret from production: tokens must not work across the two APIs.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Moderation stays real (same key as production).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=8000

# Emulators and desks: accept simulated fixes.
ALLOW_MOCK_LOCATIONS=1
JOIN_RADIUS_M=200
LEAVE_RADIUS_M=250
MAX_ACCURACY_M=100
OVERPASS_CONTACT=dogukangundogan5@gmail.com

MARKET_ENABLED=1
MARKET_PAYMENTS_ENABLED=1
MARKET_MIN_ACCOUNT_AGE_HOURS=0
MEDIA_DISK_RESERVE_BYTES=268435456

# Solana on devnet: the same keys, tree, collections and test mints as production (from pnpm solana:setup).
SOLANA_ENABLED=1
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DAS_URL=
SOLANA_AUTHORITY_SECRET=
SOLANA_ESCROW_SECRET=
SOLANA_REWARDS_SECRET=
SOLANA_STAMP_TREE=
SOLANA_STAMP_COLLECTION=
SOLANA_LEVEL_COLLECTION=
USDC_MINT=
SKR_MINT=
# Short ladder so a tester becomes a Regular on the first check-in (badge, SKR reward, Regulars room).
LOYALTY_LEVELS=1,2,3
SKR_LEVEL_REWARD=5
SOLANA_STARTER_SOL=0.05
SOLANA_STARTER_USDC=20
SOLANA_STARTER_SKR=20

LOG_PRETTY=0
