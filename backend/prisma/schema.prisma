generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  PASSED
  FAILED
}

enum MembershipStatus {
  ACTIVE
  ENDED
}

enum MembershipEndReason {
  USER_LEFT
  OUT_OF_RANGE
  STALE
  UNCONFIRMED
  VENUE_CLOSED
  SUSPENDED
  REPLACED
}

enum MessageKind {
  TEXT
  IMAGE
  POLL
}

enum MediaStatus {
  UPLOADED
  ATTACHED
  REJECTED
  QUARANTINED
}

enum MessageStatus {
  APPROVED
  CENSORED
  BLOCKED
  HIDDEN
}

enum ViolationSource {
  AUTO
  MODERATOR
}

enum EnforcementKind {
  MUTE
  SUSPEND
}

enum ListingKind {
  OFFER
  REQUEST
}

enum ListingCategory {
  FURNITURE
  ELECTRONICS
  CLOTHING
  KIDS
  HOME
  SPORTS
  BOOKS
  SERVICES
  HELP
  OTHER
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  CANCELLED
  EXPIRED
  REMOVED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ReportReason {
  HARASSMENT
  THREAT
  HATE
  SEXUAL
  SPAM
  SCAM
  PERSONAL_INFO
  OTHER
  PROHIBITED_ITEM
  OFF_PLATFORM_PAYMENT
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum IncidentKind {
  SEVERE_CONTENT
  STRIKE_THRESHOLD
  REPORT_THRESHOLD
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  displayName          String
  displayNameLower     String    @unique
  role                 Role      @default(USER)
  ageVerifiedAt        DateTime?
  ageThreshold         Int?
  verificationProvider String?
  verificationRef      String?
  mutedUntil           DateTime?
  suspendedAt          DateTime?
  suspensionReason     String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  verificationSessions VerificationSession[]
  memberships          Membership[]
  messages             Message[]
  violations           Violation[]
  enforcements         Enforcement[]
  reportsMade          Report[]              @relation("Reporter")
  reportsReceived      Report[]              @relation("ReportedUser")
  blocksMade           Block[]               @relation("Blocker")
  blocksReceived       Block[]               @relation("Blocked")
  incidents            Incident[]
  media            Media[]
  polls            Poll[]
  pollVotes        PollVote[]
  listings         Listing[]
  offers           Offer[]
  ordersAsPayer    Order[]               @relation("OrderPayer")
  ordersAsPayee    Order[]               @relation("OrderPayee")
  stripeAccount    StripeAccount?
  wallet           Wallet?
  stamps           Stamp[]
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per age-assurance attempt. Only the platform, the declaration kind and the
/// outcome are kept; never an age, birthday or document.
model VerificationSession {
  id          String             @id @default(uuid())
  userId      String
  provider    String
  providerRef String?
  status      VerificationStatus
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Venue {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  label        String   @default("General Chat")
  category     String   @default("square")
  address      String?
  source       String   @default("seed")
  sourceRef    String?
  lat          Float
  lng          Float
  joinRadiusM  Int      @default(200)
  leaveRadiusM Int      @default(250)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  messages    Message[]

  @@unique([source, sourceRef])
  @@index([lat, lng])
  stamps      Stamp[]
}

model Membership {
  id              String               @id @default(uuid())
  userId          String
  venueId         String
  status          MembershipStatus     @default(ACTIVE)
  endReason       MembershipEndReason?
  joinedAt        DateTime             @default(now())
  lastHeartbeatAt DateTime             @default(now())
  lastEligibleAt  DateTime             @default(now())
  endedAt         DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // A partial unique index "(userId) WHERE status = 'ACTIVE'" is added in a migration.
  @@index([venueId, status])
  @@index([status, lastHeartbeatAt])
}

model Message {
  id               String        @id @default(uuid())
  venueId          String
  authorId         String
  text             String
  originalText     String?
  status           MessageStatus
  severity         Int           @default(0)
  categories       String[]      @default([])
  moderationReason String?
  clientKey        String
  kind             MessageKind   @default(TEXT)
  mediaId          String?       @unique
  createdAt        DateTime      @default(now())

  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  author  User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media   Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  poll    Poll?
  reports Report[]

  @@unique([authorId, clientKey])
  @@index([venueId, createdAt])
}

/// A poll lives in the chat as a message of kind POLL and disappears with it.
model Poll {
  id        String    @id @default(uuid())
  messageId String    @unique
  venueId   String
  authorId  String
  question  String
  closed    Boolean   @default(false)
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([venueId, createdAt])
  @@index([authorId, venueId, closed])
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  position Int
  text     String

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, position])
}

/// One vote per member per poll; changing the vote updates the row.
model PollVote {
  pollId    String
  userId    String
  optionId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([optionId])
}

/// An uploaded image (re-encoded JPEG + thumbnail on the uploads volume). Rows outlive the
/// files only briefly: rejected and purged media lose their files at once.
model Media {
  id          String      @id
  ownerId     String
  status      MediaStatus @default(UPLOADED)
  width       Int
  height      Int
  bytes       Int
  thumbWidth  Int
  thumbHeight Int
  sha256      String
  createdAt   DateTime    @default(now())
  attachedAt  DateTime?

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message       Message?
  listingImages ListingImage[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
}

model Violation {
  id         String          @id @default(uuid())
  userId     String
  messageId  String?
  listingId  String?
  severity   Int
  categories String[]        @default([])
  source     ViolationSource @default(AUTO)
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Enforcement {
  id        String          @id @default(uuid())
  userId    String
  kind      EnforcementKind
  reason    String
  expiresAt DateTime?
  createdBy String          @default("SYSTEM")
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A report targets exactly one thing: a message or a listing (enforced by a CHECK constraint).
model Report {
  id             String       @id @default(uuid())
  reporterId     String
  messageId      String?
  listingId      String?
  reportedUserId String
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId])
  @@unique([reporterId, listingId])
  @@index([status, createdAt])
  @@index([messageId])
  @@index([listingId])
}

/// Something a neighbour sells (OFFER) or paid help they ask for (REQUEST). The exact position
/// is stored for the owner only; everyone else sees the geohash-7 cell centre (`publicLat/Lng`).
model Listing {
  id               String          @id @default(uuid())
  ownerId          String
  kind             ListingKind
  category         ListingCategory
  title            String
  description      String          @default("")
  priceCents       Int
  currency         String          @default("eur")
  status           ListingStatus   @default(ACTIVE)
  lat              Float
  lng              Float
  geohash7         String
  publicLat        Float
  publicLng        Float
  severity         Int             @default(0)
  categories       String[]        @default([])
  moderationReason String?
  expiresAt        DateTime
  removedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images  ListingImage[]
  offers  Offer[]
  orders  Order[]
  reports Report[]

  @@index([status, publicLat, publicLng])
  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
}

model ListingImage {
  listingId String
  mediaId   String
  position  Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([listingId, mediaId])
  @@unique([listingId, position])
}

/// A price proposed by a buyer (OFFER listing) or a helper (REQUEST listing).
model Offer {
  id          String      @id @default(uuid())
  listingId   String
  offererId   String
  amountCents Int
  note        String?
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offerer User    @relation(fields: [offererId], references: [id], onDelete: Cascade)
  order   Order?

  @@index([listingId, status])
  @@index([offererId, createdAt])
  @@index([status, expiresAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Incident {
  id        String         @id @default(uuid())
  userId    String
  kind      IncidentKind
  refId     String?
  status    IncidentStatus @default(OPEN)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/// A deal after an offer was accepted: the payer pays Larea, the payee is paid out once the
/// payer's handover code is entered. Financial records; never purged.
model Order {
  id                      String      @id @default(uuid())
  listingId               String
  offerId                 String      @unique
  payerId                 String
  payeeId                 String
  amountCents             Int
  feeCents                Int
  currency                String
  status                  OrderStatus @default(AWAITING_PAYMENT)
  cancelReason            String?
  listingTitle            String
  handoverCode            String?
  handoverAttempts        Int         @default(0)
  handoverLockedUntil     DateTime?
  stripeCheckoutSessionId String?     @unique
  stripeCheckoutUrl       String?
  checkoutExpiresAt       DateTime?
  checkoutAttempt         Int         @default(0)
  stripePaymentIntentId   String?     @unique
  stripeChargeId          String?
  stripeTransferId        String?
  stripeRefundId          String?
  paymentDueAt            DateTime
  paidAt                  DateTime?
  approvalDeadlineAt      DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  refundedAt              DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  payer   User    @relation("OrderPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee   User    @relation("OrderPayee", fields: [payeeId], references: [id], onDelete: Restrict)

  @@index([status, paidAt])
  @@index([status, paymentDueAt])
  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
}

/// The Stripe Connect Express account that receives a user's payouts.
model StripeAccount {
  userId           String   @id
  stripeAccountId  String   @unique
  payoutsEnabled   Boolean  @default(false)
  chargesEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  requirementsDue  String[] @default([])
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Webhook deliveries already handled (Stripe retries; Redis may evict).
model StripeEvent {
  id          String    @id
  type        String
  account     String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([receivedAt])
}

/// The Solana wallet a user linked by signing in with it (dApp Store build). One per account and per address.
model Wallet {
  userId   String   @id
  address  String   @unique
  linkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum StampStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// A check-in: a soulbound compressed NFT minted to the user's wallet at a place (dApp Store build).
/// PENDING until the transaction lands; at most one CONFIRMED stamp per user, place and day.
model Stamp {
  id          String      @id @default(uuid())
  userId      String
  venueId     String
  wallet      String
  /// UTC date of the visit, YYYY-MM-DD.
  day         String
  /// Which visit this is at the place (1 = first).
  visit       Int
  status      StampStatus @default(PENDING)
  /// sha256 of the transaction message we built; a submitted transaction must match it.
  messageHash String
  signature   String?     @unique
  assetId     String?     @unique
  leafIndex   Int?
  /// Loyalty level badge minted in the same transaction (S3), if this visit reached one.
  levelMinted Int?
  error       String?
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId, venueId, status])
  @@index([status, createdAt])
}
